# LLM Provider selection: 'openrouter' (cloud) or 'ollama' (local)
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Required if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama Configuration (Used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# GitHub Configuration (Optional, for higher rate limits)
GITHUB_TOKEN=

# Session Configuration
MAX_SESSION_TURNS=15
LOG_LEVEL=INFO
